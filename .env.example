VH_USERNAME=
VH_PASSWORD=
VH_HEALTH_CHECK_INTERVAL_MS=15000
VH_EVENT_STALE_MS=90000
VH_PAGE_STALE_MS=120000
VH_RESTART_DELAY_MS=8000
VH_OFFLINE_RETRY_DELAY_MS=30000
VH_MAX_CONSECUTIVE_FAILURES=3
VH_BROWSER_CLOSE_TIMEOUT_MS=10000
VH_BROWSER_ERROR_CONFIRM_MS=10000
VH_BROWSER_HEALTHY_RESET_MS=60000
FORCE_MANUAL_LOGIN=false
LOG_ODDS_DETAILS=false
VH_DEBUG_MARKET_PAYLOADS=false
LOG_RESULT_RAW_DUMP=false
LOG_RESULT_SUMMARY=true
REACT_DISPLAY_URL=http://localhost:3001
VIRTUAL_API_BASE_URL=http://localhost:3000
VH_LIVE_STATE_FILE=data/provider-live-state.json
# Wall elapsed minus monotonic elapsed: default 5s, accepted range 1s–60s.
VH_CLOCK_DISCONTINUITY_MS=5000
# Posting timestamp skew against the per-event provider reference: 1s–60s.
VH_TIMESTAMP_FUTURE_SKEW_MS=30000
PROVIDER_IMPORT_QUEUE_URL=http://localhost:3000/api/provider-imports/virtual-horizon/feed-events-queue
PROVIDER_IMPORT_RESULTS_URL=http://localhost:3000/api/provider-imports/virtual-horizon/results
SYNC_INTERVAL_SECONDS=30
